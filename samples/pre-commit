#!/bin/sh
set -eu

# Read the index, including partial staging, rather than working-tree files.
scratch=$(mktemp -d "${TMPDIR:-/tmp}/draft-pre-commit.XXXXXX")
trap 'rm -rf "$scratch"' EXIT
paths=$(git -c core.quotePath=false diff --cached --name-only --no-renames --diff-filter=ACMT -- content/articles/)

failed=0
# Article filenames must not contain whitespace.
for path in $paths; do
    case "$path" in
        *.md|*.markdown) ;;
        *) continue ;;
    esac
    git show ":$path" > "$scratch/article"
    # Check matching lines before the first empty line.
    matches=$(sed -n '/^$/q; /draft.*true/p' "$scratch/article")
    if [ -n "$matches" ]; then
        printf 'error: draft = true: %s\n' "$path" >&2
        failed=1
    fi
done

if [ "$failed" -ne 0 ]; then
    echo 'Commit rejected. Set draft = false in these articles and stage the changes again.' >&2
fi
exit "$failed"
